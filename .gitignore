# ============================================
# ZenitCheck - .gitignore
# ============================================

# Private user documents & credentials (strictly local, never in git/github)
documentos/
*credenciales*
*crendenciales*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
.venv/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
collected_static/

# Environment variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# OS
.DS_Store
Thumbs.db
desktop.ini

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover

# pytest
.pytest_cache/
.tox/
.nox/

# ML Models (heavy binary files)
*.pth
*.pt
*.onnx
*.h5
*.tflite
*.pkl
ai_engine/models/weights/

# Node (Tailwind build)
node_modules/

# Compiled static
static/css/output.css

# PDF generated certificates & private keys (never in git)
certificates/
certs/*.pem
certs/*.key
certs/*.p12
certs/*.pfx

# Temporary files
tmp/
temp/
*.tmp
scripts/bootstrap.py
