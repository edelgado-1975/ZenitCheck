# ============================================
# ZenitCheck - Plantilla de Variables de Entorno
# ============================================
# Copiar a .env y completar los valores
# ============================================

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_ENGINE=sqlite3
DATABASE_NAME=db.sqlite3
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=zenitcheck
# DATABASE_PASSWORD=

MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=10

AI_CONFIDENCE_THRESHOLD=0.5
AI_MODEL_PATH=ai_engine/models/weights/

CERT_KEY_PATH=certs/private_key.pem
CERT_CHAIN_PATH=certs/certificate.pem
